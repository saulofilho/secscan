# SecScan Application Environment Configuration Example
# Copy this file to .env and provide your local credentials.
# NEVER commit the actual .env file or sensitive keys to version control.

# Google Gemini AI Key (Optional - for AI Remediation Copilot on server)
GEMINI_API_KEY=

# Google AdSense Monetization (Optional - if blank, no ads will be rendered)
# Format: ca-pub-XXXXXXXXXXXXXXXX (16 digits)
VITE_ADSENSE_CLIENT_ID=
# Format: 10 digits slot ID from Google AdSense banner unit
VITE_ADSENSE_SLOT_ID=
